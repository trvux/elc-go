ENV=development
PORT=8090

# Self-hosted Postgres (docker-compose service `postgres`; production's
# deploy.yml writes this itself). For local dev against the published port:
DATABASE_URL=postgresql://elc:<POSTGRES_PASSWORD>@localhost:5432/elc?sslmode=disable

# auth module
# JWT_SECRET signs access tokens — must be a long random value in
# production (e.g. `openssl rand -base64 48`), never the literal below.
JWT_SECRET=change-me-to-a-long-random-value
# APP_BASE_URL is used to build the magic-link URL emailed to sign in.
APP_BASE_URL=https://dienmayelc.com.vn

# GOOGLE_CLIENT_ID/SECRET back Google sign-in (see
# internal/auth/infrastructure/google_oauth.go). Optional in development: if
# unset, Google sign-in fails at request time but magic-link sign-in still
# works fully.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ADMIN_EMAILS is a comma-separated "email:role" allowlist, applied the
# FIRST time each email ever signs in (Google or magic link); a bare email
# with no ":role" defaults to admin. Any email not listed becomes
# role=member. Checked only at account-creation time — promoting anyone
# else afterward is a deliberate admin action via PATCH /admin/users/{id},
# not config. Valid roles: super_admin, admin, user (day-to-day content
# work only, no user/settings management).
ADMIN_EMAILS=you@example.com:super_admin,teammate@example.com:admin,staff@example.com:user

# SMTP is optional in development: if unset, magic-link emails are logged
# instead of sent (see internal/auth/infrastructure/email_sender.go).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@dienmayelc.com.vn
