ENV=development
PORT=8090

# Supabase Postgres via the connection pooler (PgBouncer transaction mode),
# NOT the direct 5432 connection — see ARCHITECTURE.md section 7.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# auth module
# JWT_SECRET signs access tokens — must be a long random value in
# production (e.g. `openssl rand -base64 48`), never the literal below.
JWT_SECRET=change-me-to-a-long-random-value
# ADMIN_BASE_URL is used to build invite/reset links emailed to admins.
ADMIN_BASE_URL=https://dienmayelc.com.vn

# SMTP is optional in development: if unset, invite/reset links are logged
# instead of emailed (see internal/auth/infrastructure/email_sender.go).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@dienmayelc.com.vn

# ai module — optional: if AI_PROVIDER_BASE_URL is unset, /ai/chat is not
# mounted (see cmd/server/main.go). Any OpenAI-compatible chat-completions
# provider works, not just DeepSeek — swapping to GLM/Moonshot/etc. later is
# just these three values, no code change.
# DeepSeek: https://api.deepseek.com/v1, model "deepseek-chat"
AI_PROVIDER_BASE_URL=
AI_PROVIDER_API_KEY=
AI_PROVIDER_MODEL=
