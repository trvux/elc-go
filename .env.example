ENV=development
PORT=8090

# Supabase Postgres via the connection pooler (PgBouncer transaction mode),
# NOT the direct 5432 connection — see ARCHITECTURE.md section 7.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# auth module
# JWT_SECRET signs access tokens — must be a long random value in
# production (e.g. `openssl rand -base64 48`), never the literal below.
JWT_SECRET=change-me-to-a-long-random-value
# APP_BASE_URL is used to build the magic-link URL emailed to sign in.
APP_BASE_URL=https://dienmayelc.com.vn

# GOOGLE_CLIENT_ID/SECRET back Google sign-in (see
# internal/auth/infrastructure/google_oauth.go). Optional in development: if
# unset, Google sign-in fails at request time but magic-link sign-in still
# works fully.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ADMIN_EMAILS is a comma-separated allowlist: an email on this list gets
# role=super_admin the FIRST time it ever signs in (Google or magic link);
# every other email becomes role=member. Checked only at account-creation
# time — promoting anyone else afterward is a deliberate admin action via
# PATCH /admin/users/{id}, not config.
ADMIN_EMAILS=you@example.com

# SMTP is optional in development: if unset, magic-link emails are logged
# instead of sent (see internal/auth/infrastructure/email_sender.go).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@dienmayelc.com.vn

# ai module — provider/model/fallback config lives in the DB (admin-managed
# via /ai/providers, /ai/models — see docs/rfc/2026-08-18-ai-chat-phase1-*),
# not env vars. AI_SECRETS_ENCRYPTION_KEY is the one thing that must still
# come from env: it encrypts stored provider API keys at rest, required to
# start the server (fails fast like JWT_SECRET if unset/invalid).
# Generate with: openssl rand -base64 32
AI_SECRETS_ENCRYPTION_KEY=

# The AI_PROVIDER_*/AI_CLASSIFIER_MODEL vars below are only read by the
# one-shot bootstrap CLIs (cmd/seed-ai-provider, then cmd/sync-ai-pricing to
# fill in real pricing) — not by the server itself. Any OpenAI-compatible
# chat-completions provider works, not just DeepSeek.
# DeepSeek: https://api.deepseek.com/v1, model "deepseek-chat",
# pricing doc https://api-docs.deepseek.com/quick_start/pricing/
AI_PROVIDER_NAME=deepseek
AI_PROVIDER_DISPLAY_NAME=DeepSeek
AI_PROVIDER_BASE_URL=
AI_PROVIDER_API_KEY=
AI_PROVIDER_MODEL=
AI_PROVIDER_PRICING_DOC_URL=
AI_CLASSIFIER_MODEL=

# Optional: Redis-backed rate limiting + classifier/search_products caching
# for /ai/chat (see docs/rfc/2026-08-18-ai-chat-redis.md). Unset = falls
# back to in-memory rate limiting (same as before) and no caching — the
# server starts and runs fine either way, this is purely a performance/cost
# optimization, never required.
REDIS_URL=redis://redis:6379/0
